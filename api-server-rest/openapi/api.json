{
  "openapi": "3.1.0",
  "info": {
    "title": "CoCo RESTful API",
    "description": "HTTP based API for CoCo containers to get resource/evidence/token from confidential-data-hub and attestation-agent.",
    "contact": {
      "name": "The Confidential Container Authors"
    },
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8006",
      "description": "CoCo RESTful API"
    }
  ],
  "paths": {
    "/aa/aael": {
      "post": {
        "tags": [],
        "operationId": "_aael",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AaelEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "success response"
          },
          "400": {
            "description": "bad request for invalid body"
          },
          "403": {
            "description": "forbid external access or a reserved event domain"
          },
          "405": {
            "description": "only POST method allowed"
          }
        }
      }
    },
    "/aa/additional-evidence": {
      "get": {
        "tags": [],
        "operationId": "_additional_evidence",
        "parameters": [
          {
            "name": "runtime_data",
            "in": "query",
            "description": "Runtime Data",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "encoding",
            "in": "query",
            "description": "Runtime data encoding; use `base64` for URL-safe base64 (no padding)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string"
                },
                "example": {
                  "sev-snp": "..."
                }
              }
            }
          },
          "400": {
            "description": "bad request for invalid query param"
          },
          "403": {
            "description": "forbid external access"
          },
          "404": {
            "description": "resource not found"
          },
          "405": {
            "description": "only Get method allowed"
          }
        }
      }
    },
    "/aa/evidence": {
      "get": {
        "tags": [],
        "operationId": "_evidence",
        "parameters": [
          {
            "name": "runtime_data",
            "in": "query",
            "description": "Runtime Data",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "encoding",
            "in": "query",
            "description": "Runtime data encoding; use `base64` for URL-safe base64 (no padding)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string"
                },
                "example": {
                  "report_data": "eHh4eA==",
                  "svn": "1"
                }
              }
            }
          },
          "400": {
            "description": "bad request for invalid query param"
          },
          "403": {
            "description": "forbid external access"
          },
          "404": {
            "description": "resource not found"
          },
          "405": {
            "description": "only Get method allowed"
          }
        }
      }
    },
    "/aa/token": {
      "get": {
        "tags": [],
        "description": "Forwards every query parameter except `token_type` to the attestation agent. ASR does not filter keys. `kbs` accepts none. `coco_as` accepts at most one of `nonce` (URL-safe base64 without padding, the evidence challenge) or `runtime_data` (a string of JSON text). Use POST to send `runtime_data`.",
        "operationId": "_token",
        "parameters": [
          {
            "name": "token_type",
            "in": "query",
            "description": "Token Type",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nonce",
            "in": "query",
            "description": "Optional string parameter. For coco_as, URL-safe base64 (no padding) evidence challenge",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "success response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string"
                },
                "example": {
                  "tee_keypair": "-----BEGIN RSA... ",
                  "token": "eyJhbGciOiJFUzI1NiI..."
                }
              }
            }
          },
          "400": {
            "description": "bad request for a missing token type"
          },
          "403": {
            "description": "forbid external access"
          },
          "404": {
            "description": "resource not found"
          },
          "405": {
            "description": "method not allowed"
          }
        }
      },
      "post": {
        "tags": [],
        "description": "Merges the JSON object of strings in the body with every query parameter except `token_type`. Body values replace query values for the same key. Values must be strings; nested JSON is rejected. `runtime_data` is a string of JSON text. Which keys each token type accepts is decided by the attestation agent.",
        "operationId": "_token_post",
        "parameters": [
          {
            "name": "token_type",
            "in": "query",
            "description": "Token Type",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenParameters"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "success response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string"
                },
                "example": {
                  "tee_keypair": "-----BEGIN RSA... ",
                  "token": "eyJhbGciOiJFUzI1NiI..."
                }
              }
            }
          },
          "400": {
            "description": "bad request for an invalid query or body"
          },
          "403": {
            "description": "forbid external access"
          },
          "404": {
            "description": "resource not found"
          },
          "405": {
            "description": "method not allowed"
          }
        }
      }
    },
    "/cdh/resource/{repository}/{type}/{tag}": {
      "get": {
        "tags": [],
        "operationId": "_resource",
        "responses": {
          "200": {
            "description": "success response",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string"
                },
                "example": {
                  "123456": "value"
                }
              }
            }
          },
          "403": {
            "description": "forbid external access"
          },
          "404": {
            "description": "resource not found"
          },
          "405": {
            "description": "only Get method allowed"
          }
        }
      }
    },
    "/info": {
      "get": {
        "tags": [],
        "operationId": "_version",
        "responses": {
          "200": {
            "description": "success response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                },
                "example": {
                  "additional_tees": [],
                  "feature": "resource",
                  "tee": "tdx",
                  "version": "v1.0.0"
                }
              }
            }
          },
          "403": {
            "description": "forbid external access"
          },
          "404": {
            "description": "resource not found"
          },
          "405": {
            "description": "only Get method allowed"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AaelEvent": {
        "type": "object",
        "required": [
          "domain",
          "operation",
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "description": "Attestation Agent Event Log Content. Must be free of control characters."
          },
          "domain": {
            "type": "string",
            "description": "Attestation Agent Event Log Domain. Must be non-empty and free of\nwhitespace and control characters. The `github.com/confidential-containers`\nnamespace is reserved for the guest components themselves."
          },
          "operation": {
            "type": "string",
            "description": "Attestation Agent Event Log Operation. Must be non-empty and free of\nwhitespace and control characters."
          }
        }
      },
      "TokenParameters": {
        "type": "object",
        "properties": {
          "runtime_data": {
            "type": [
              "string",
              "null"
            ],
            "description": "String of JSON text forwarded to the attestation service. Not a nested JSON object."
          }
        }
      },
      "VersionInfo": {
        "type": "object",
        "required": [
          "version",
          "additional_tees",
          "feature"
        ],
        "properties": {
          "additional_tees": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional TEE types"
          },
          "feature": {
            "type": "string",
            "description": "User provided feature command line argument for the API server"
          },
          "tee": {
            "type": [
              "string",
              "null"
            ],
            "description": "TEE type (optional)"
          },
          "version": {
            "type": "string",
            "description": "Version string"
          }
        }
      }
    }
  }
}